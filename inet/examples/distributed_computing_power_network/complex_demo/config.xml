<config>
    <!-- User access links -->
    <interface hosts="user1" towards="userGateway1" address="10.1.1.1" netmask="255.255.255.0"/>
    <interface hosts="userGateway1" towards="user1" address="10.1.1.2" netmask="255.255.255.0"/>
    <interface hosts="user2" towards="userGateway1" address="10.1.2.1" netmask="255.255.255.0"/>
    <interface hosts="userGateway1" towards="user2" address="10.1.2.2" netmask="255.255.255.0"/>
    <interface hosts="user3" towards="userGateway1" address="10.1.3.1" netmask="255.255.255.0"/>
    <interface hosts="userGateway1" towards="user3" address="10.1.3.2" netmask="255.255.255.0"/>
    <interface hosts="user4" towards="userGateway2" address="10.1.4.1" netmask="255.255.255.0"/>
    <interface hosts="userGateway2" towards="user4" address="10.1.4.2" netmask="255.255.255.0"/>
    <interface hosts="user5" towards="userGateway2" address="10.1.5.1" netmask="255.255.255.0"/>
    <interface hosts="userGateway2" towards="user5" address="10.1.5.2" netmask="255.255.255.0"/>
    <interface hosts="user6" towards="userGateway2" address="10.1.6.1" netmask="255.255.255.0"/>
    <interface hosts="userGateway2" towards="user6" address="10.1.6.2" netmask="255.255.255.0"/>

    <!-- User gateways to core -->
    <interface hosts="userGateway1" towards="router1" address="10.1.10.1" netmask="255.255.255.0"/>
    <interface hosts="router1" towards="userGateway1" address="10.1.10.2" netmask="255.255.255.0"/>
    <interface hosts="userGateway1" towards="router4" address="10.1.11.1" netmask="255.255.255.0"/>
    <interface hosts="router4" towards="userGateway1" address="10.1.11.2" netmask="255.255.255.0"/>
    <interface hosts="userGateway2" towards="router2" address="10.1.12.1" netmask="255.255.255.0"/>
    <interface hosts="router2" towards="userGateway2" address="10.1.12.2" netmask="255.255.255.0"/>
    <interface hosts="userGateway2" towards="router3" address="10.1.13.1" netmask="255.255.255.0"/>
    <interface hosts="router3" towards="userGateway2" address="10.1.13.2" netmask="255.255.255.0"/>

    <!-- Core ring and diagonal links -->
    <interface hosts="router1" towards="router2" address="10.1.20.1" netmask="255.255.255.0"/>
    <interface hosts="router2" towards="router1" address="10.1.20.2" netmask="255.255.255.0"/>
    <interface hosts="router2" towards="router3" address="10.1.21.1" netmask="255.255.255.0"/>
    <interface hosts="router3" towards="router2" address="10.1.21.2" netmask="255.255.255.0"/>
    <interface hosts="router3" towards="router4" address="10.1.22.1" netmask="255.255.255.0"/>
    <interface hosts="router4" towards="router3" address="10.1.22.2" netmask="255.255.255.0"/>
    <interface hosts="router4" towards="router1" address="10.1.23.1" netmask="255.255.255.0"/>
    <interface hosts="router1" towards="router4" address="10.1.23.2" netmask="255.255.255.0"/>
    <interface hosts="router1" towards="router3" address="10.1.24.1" netmask="255.255.255.0"/>
    <interface hosts="router3" towards="router1" address="10.1.24.2" netmask="255.255.255.0"/>
    <interface hosts="router2" towards="router4" address="10.1.25.1" netmask="255.255.255.0"/>
    <interface hosts="router4" towards="router2" address="10.1.25.2" netmask="255.255.255.0"/>

    <!-- Compute gateways are dual-homed to the looped core. -->
    <interface hosts="router1" towards="computeGateway1" address="10.1.30.1" netmask="255.255.255.0"/>
    <interface hosts="computeGateway1" towards="router1" address="10.1.30.2" netmask="255.255.255.0"/>
    <interface hosts="router2" towards="computeGateway1" address="10.1.31.1" netmask="255.255.255.0"/>
    <interface hosts="computeGateway1" towards="router2" address="10.1.31.2" netmask="255.255.255.0"/>
    <interface hosts="router2" towards="computeGateway2" address="10.1.32.1" netmask="255.255.255.0"/>
    <interface hosts="computeGateway2" towards="router2" address="10.1.32.2" netmask="255.255.255.0"/>
    <interface hosts="router3" towards="computeGateway2" address="10.1.33.1" netmask="255.255.255.0"/>
    <interface hosts="computeGateway2" towards="router3" address="10.1.33.2" netmask="255.255.255.0"/>
    <interface hosts="router3" towards="computeGateway3" address="10.1.34.1" netmask="255.255.255.0"/>
    <interface hosts="computeGateway3" towards="router3" address="10.1.34.2" netmask="255.255.255.0"/>
    <interface hosts="router4" towards="computeGateway3" address="10.1.35.1" netmask="255.255.255.0"/>
    <interface hosts="computeGateway3" towards="router4" address="10.1.35.2" netmask="255.255.255.0"/>
    <interface hosts="router4" towards="computeGateway4" address="10.1.36.1" netmask="255.255.255.0"/>
    <interface hosts="computeGateway4" towards="router4" address="10.1.36.2" netmask="255.255.255.0"/>
    <interface hosts="router1" towards="computeGateway4" address="10.1.37.1" netmask="255.255.255.0"/>
    <interface hosts="computeGateway4" towards="router1" address="10.1.37.2" netmask="255.255.255.0"/>

    <!-- Compute access links -->
    <interface hosts="computeGateway1" towards="computeNode1" address="10.1.40.1" netmask="255.255.255.0"/>
    <interface hosts="computeNode1" towards="computeGateway1" address="10.1.40.2" netmask="255.255.255.0"/>
    <interface hosts="computeGateway1" towards="computeNode2" address="10.1.41.1" netmask="255.255.255.0"/>
    <interface hosts="computeNode2" towards="computeGateway1" address="10.1.41.2" netmask="255.255.255.0"/>
    <interface hosts="computeGateway1" towards="computeNode3" address="10.1.42.1" netmask="255.255.255.0"/>
    <interface hosts="computeNode3" towards="computeGateway1" address="10.1.42.2" netmask="255.255.255.0"/>
    <interface hosts="computeGateway2" towards="computeNode4" address="10.1.43.1" netmask="255.255.255.0"/>
    <interface hosts="computeNode4" towards="computeGateway2" address="10.1.43.2" netmask="255.255.255.0"/>
    <interface hosts="computeGateway2" towards="computeNode5" address="10.1.44.1" netmask="255.255.255.0"/>
    <interface hosts="computeNode5" towards="computeGateway2" address="10.1.44.2" netmask="255.255.255.0"/>
    <interface hosts="computeGateway2" towards="computeNode6" address="10.1.45.1" netmask="255.255.255.0"/>
    <interface hosts="computeNode6" towards="computeGateway2" address="10.1.45.2" netmask="255.255.255.0"/>
    <interface hosts="computeGateway3" towards="computeNode7" address="10.1.46.1" netmask="255.255.255.0"/>
    <interface hosts="computeNode7" towards="computeGateway3" address="10.1.46.2" netmask="255.255.255.0"/>
    <interface hosts="computeGateway3" towards="computeNode8" address="10.1.47.1" netmask="255.255.255.0"/>
    <interface hosts="computeNode8" towards="computeGateway3" address="10.1.47.2" netmask="255.255.255.0"/>
    <interface hosts="computeGateway3" towards="computeNode9" address="10.1.48.1" netmask="255.255.255.0"/>
    <interface hosts="computeNode9" towards="computeGateway3" address="10.1.48.2" netmask="255.255.255.0"/>
    <interface hosts="computeGateway4" towards="computeNode10" address="10.1.49.1" netmask="255.255.255.0"/>
    <interface hosts="computeNode10" towards="computeGateway4" address="10.1.49.2" netmask="255.255.255.0"/>
    <interface hosts="computeGateway4" towards="computeNode11" address="10.1.50.1" netmask="255.255.255.0"/>
    <interface hosts="computeNode11" towards="computeGateway4" address="10.1.50.2" netmask="255.255.255.0"/>
    <interface hosts="computeGateway4" towards="computeNode12" address="10.1.51.1" netmask="255.255.255.0"/>
    <interface hosts="computeNode12" towards="computeGateway4" address="10.1.51.2" netmask="255.255.255.0"/>

    <!-- Multicast membership by computing type. -->
    <multicast-group hosts="computeNode1 computeNode3 computeNode5 computeNode7 computeNode9 computeNode11 computeGateway1 computeGateway2 computeGateway3 computeGateway4" address="225.0.1.1"/>
    <multicast-group hosts="computeNode2 computeNode4 computeNode6 computeNode8 computeNode10 computeNode12 computeGateway1 computeGateway2 computeGateway3 computeGateway4" address="225.0.1.2"/>

    <!-- Core multicast tree for CPRP_REQ. Physical links contain loops; this tree does not. -->
    <multicast-route hosts="userGateway1" groups="225.0.1.1 225.0.1.2" children=">router1 >router4"/>
    <multicast-route hosts="userGateway2" groups="225.0.1.1 225.0.1.2" children=">router2 >router3"/>
    <multicast-route hosts="router1" groups="225.0.1.1 225.0.1.2" children=">computeGateway1 >computeGateway4 >router2"/>
    <multicast-route hosts="router2" groups="225.0.1.1 225.0.1.2" children=">computeGateway1 >computeGateway2 >router3"/>
    <multicast-route hosts="router3" groups="225.0.1.1 225.0.1.2" children=">computeGateway2 >computeGateway3 >router4"/>
    <multicast-route hosts="router4" groups="225.0.1.1 225.0.1.2" children=">computeGateway3 >computeGateway4"/>

    <!-- Local compute-domain multicast. -->
    <multicast-route hosts="computeGateway1" groups="225.0.1.1" children=">computeNode1 >computeNode3"/>
    <multicast-route hosts="computeGateway1" groups="225.0.1.2" children=">computeNode2"/>
    <multicast-route hosts="computeGateway2" groups="225.0.1.1" children=">computeNode5"/>
    <multicast-route hosts="computeGateway2" groups="225.0.1.2" children=">computeNode4 >computeNode6"/>
    <multicast-route hosts="computeGateway3" groups="225.0.1.1" children=">computeNode7 >computeNode9"/>
    <multicast-route hosts="computeGateway3" groups="225.0.1.2" children=">computeNode8"/>
    <multicast-route hosts="computeGateway4" groups="225.0.1.1" children=">computeNode11"/>
    <multicast-route hosts="computeGateway4" groups="225.0.1.2" children=">computeNode10 >computeNode12"/>

    <!-- Local CGMP report return routes. -->
    <multicast-route hosts="computeNode1" groups="225.0.1.1" children=">computeGateway1"/>
    <multicast-route hosts="computeNode2" groups="225.0.1.2" children=">computeGateway1"/>
    <multicast-route hosts="computeNode3" groups="225.0.1.1" children=">computeGateway1"/>
    <multicast-route hosts="computeNode4" groups="225.0.1.2" children=">computeGateway2"/>
    <multicast-route hosts="computeNode5" groups="225.0.1.1" children=">computeGateway2"/>
    <multicast-route hosts="computeNode6" groups="225.0.1.2" children=">computeGateway2"/>
    <multicast-route hosts="computeNode7" groups="225.0.1.1" children=">computeGateway3"/>
    <multicast-route hosts="computeNode8" groups="225.0.1.2" children=">computeGateway3"/>
    <multicast-route hosts="computeNode9" groups="225.0.1.1" children=">computeGateway3"/>
    <multicast-route hosts="computeNode10" groups="225.0.1.2" children=">computeGateway4"/>
    <multicast-route hosts="computeNode11" groups="225.0.1.1" children=">computeGateway4"/>
    <multicast-route hosts="computeNode12" groups="225.0.1.2" children=">computeGateway4"/>

    <!-- Edge host default routes. -->
    <route hosts="user1" destination="*" netmask="*" gateway="10.1.1.2" interface="ppp0" metric="0"/>
    <route hosts="user2" destination="*" netmask="*" gateway="10.1.2.2" interface="ppp0" metric="0"/>
    <route hosts="user3" destination="*" netmask="*" gateway="10.1.3.2" interface="ppp0" metric="0"/>
    <route hosts="user4" destination="*" netmask="*" gateway="10.1.4.2" interface="ppp0" metric="0"/>
    <route hosts="user5" destination="*" netmask="*" gateway="10.1.5.2" interface="ppp0" metric="0"/>
    <route hosts="user6" destination="*" netmask="*" gateway="10.1.6.2" interface="ppp0" metric="0"/>
    <route hosts="computeNode1" destination="*" netmask="*" gateway="10.1.40.1" interface="ppp0" metric="0"/>
    <route hosts="computeNode2" destination="*" netmask="*" gateway="10.1.41.1" interface="ppp0" metric="0"/>
    <route hosts="computeNode3" destination="*" netmask="*" gateway="10.1.42.1" interface="ppp0" metric="0"/>
    <route hosts="computeNode4" destination="*" netmask="*" gateway="10.1.43.1" interface="ppp0" metric="0"/>
    <route hosts="computeNode5" destination="*" netmask="*" gateway="10.1.44.1" interface="ppp0" metric="0"/>
    <route hosts="computeNode6" destination="*" netmask="*" gateway="10.1.45.1" interface="ppp0" metric="0"/>
    <route hosts="computeNode7" destination="*" netmask="*" gateway="10.1.46.1" interface="ppp0" metric="0"/>
    <route hosts="computeNode8" destination="*" netmask="*" gateway="10.1.47.1" interface="ppp0" metric="0"/>
    <route hosts="computeNode9" destination="*" netmask="*" gateway="10.1.48.1" interface="ppp0" metric="0"/>
    <route hosts="computeNode10" destination="*" netmask="*" gateway="10.1.49.1" interface="ppp0" metric="0"/>
    <route hosts="computeNode11" destination="*" netmask="*" gateway="10.1.50.1" interface="ppp0" metric="0"/>
    <route hosts="computeNode12" destination="*" netmask="*" gateway="10.1.51.1" interface="ppp0" metric="0"/>
</config>
