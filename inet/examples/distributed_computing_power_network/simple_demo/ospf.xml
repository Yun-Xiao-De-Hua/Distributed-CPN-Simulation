<?xml version="1.0"?>
<OSPFASConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="OSPF.xsd">
  <Area id="0.0.0.0">
    <!-- OSPF area address ranges are explicit subnets to avoid resolver ambiguity. -->
    <AddressRange address="10.0.0.0" mask="255.255.255.0"/>
    <AddressRange address="10.0.1.0" mask="255.255.255.0"/>
    <AddressRange address="10.0.2.0" mask="255.255.255.0"/>
    <AddressRange address="10.0.3.0" mask="255.255.255.0"/>
    <AddressRange address="10.0.4.0" mask="255.255.255.0"/>
    <AddressRange address="10.0.5.0" mask="255.255.255.0"/>
    <AddressRange address="10.0.6.0" mask="255.255.255.0"/>
    <AddressRange address="10.0.7.0" mask="255.255.255.0"/>
  </Area>
  
  
  <!-- 核心路由器 -->
  <Router name="router1" RFC1583Compatible="true">
    <PointToPointInterface ifName="ppp0" areaID="0.0.0.0" interfaceOutputCost="1"/>
    <PointToPointInterface ifName="ppp1" areaID="0.0.0.0" interfaceOutputCost="1"/>	    
    <PointToPointInterface ifName="ppp2" areaID="0.0.0.0" interfaceOutputCost="1"/> 
  </Router>

  <!-- 用户网关 -->
  <Router name="userGateway1" RFC1583Compatible="true">
    <PointToPointInterface ifName="ppp1" areaID="0.0.0.0" interfaceOutputCost="1"/>
    <HostInterface ifName="ppp0" areaID="0.0.0.0" attachedHost="10.0.0.1" linkCost="1"/>
  </Router>

  <!-- 算力网关 1 -->
  <Router name="computeGateway1" RFC1583Compatible="true">
    <HostInterface ifName="ppp0" areaID="0.0.0.0" attachedHost="10.0.4.2" linkCost="1"/>
    <PointToPointInterface ifName="ppp1" areaID="0.0.0.0" interfaceOutputCost="1"/>
    <HostInterface ifName="ppp2" areaID="0.0.0.0" attachedHost="10.0.6.2" linkCost="1"/>
  </Router>

  <!-- 算力网关 2 -->
  <Router name="computeGateway2" RFC1583Compatible="true">
    <HostInterface ifName="ppp0" areaID="0.0.0.0" attachedHost="10.0.5.2" linkCost="1"/>
    <PointToPointInterface ifName="ppp1" areaID="0.0.0.0" interfaceOutputCost="1"/>
    <HostInterface ifName="ppp2" areaID="0.0.0.0" attachedHost="10.0.7.2" linkCost="1"/>
  </Router>

</OSPFASConfig>
